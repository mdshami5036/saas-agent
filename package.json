{
  "name": "print-agent",
  "version": "1.0.0",
  "description": "Standalone Portable Windows Print Agent for Cyber Cafes",
  "main": "src/agent.js",
  "bin": "src/agent.js",
  "scripts": {
    "start": "node src/agent.js",
    "build:exe": "node build.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "express": "^4.18.3",
    "node-notifier": "^10.0.1",
    "open": "^8.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "src/gui/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
